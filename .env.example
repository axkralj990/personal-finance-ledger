# Host-side Compose settings. Use an absolute Synology path in production.
FINANCE_DATA_PATH=./data/runtime
FINANCE_HOST_PORT=8000
FINANCE_IMAGE_TAG=latest

# Application limits and local reporting timezone. Upload bytes are decimal-free integers.
TIMEZONE=Europe/Ljubljana
MAX_UPLOAD_BYTES=20971520
MAX_FILE_ROWS=20000
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
MARKET_DATA_TIMEOUT_SECONDS=10
QUOTE_PREVIEW_MAX_AGE_HOURS=24

# Container paths are fixed by compose.yaml. FINANCE_DATA_PATH is mounted at DATA_DIR.
# These values document the image contract and are overridden by Compose.
DATA_DIR=/data
FRONTEND_DIST_PATH=/app/frontend/dist
